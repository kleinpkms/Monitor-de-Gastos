# Modelo do arquivo de login. Copie para `.streamlit/secrets.toml`
# (que está no .gitignore) e preencha com os dados da sua aplicação Auth0.
#
#     cp secrets.toml.example .streamlit/secrets.toml
#
# Para gerar o cookie_secret:
#
#     python -c "import secrets; print(secrets.token_hex(32))"

[auth]
# Tem de bater exatamente com a "Allowed Callback URL" do Auth0.
# Local:    http://localhost:8501/oauth2callback
# Render:   https://SEU-APP.onrender.com/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# Chave que assina o cookie de sessão. Qualquer string longa e aleatória,
# só sua. Trocar o valor desloga todo mundo.
cookie_secret = "troque-por-uma-string-aleatoria-longa"

[auth.auth0]
client_id = "o Client ID da aplicação no Auth0"
client_secret = "o Client Secret da aplicação no Auth0"

# Troque SEU-TENANT e a região pelo domínio que o Auth0 mostra na
# aplicação — por exemplo dev-ab12cd34.us.auth0.com
server_metadata_url = "https://SEU-TENANT.us.auth0.com/.well-known/openid-configuration"

# prompt = "login" faz o Auth0 perguntar quem é você a cada entrada, em vez
# de reaproveitar em silêncio a última conta. Tire se preferir o contrário.
client_kwargs = { prompt = "login" }
